{
	"schemaVersion": 1,
	"id": "poopsmith",
	"version": "${version}",
	"name": "Poopsmith",
	"description": "Animals poop, players poop, bats poop guano, and it all composts down: poop and guano layers that decay into bonemeal, throwable poop, bat boxes, dung-fired furnaces, and a server-tracked poop bar (server-side with Pandorical)",
	"authors": [
		"justfatlard"
	],
	"contact": {
		"sources": "https://github.com/fatlard1993/poopsmith"
	},
	"license": "MIT",
	"icon": "assets/poopsmith/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"justfatlard.poopsmith.Main"
		]
	},
	"mixins": [
		"poopsmith.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loaderVersion}",
		"fabric-api": "${fabricApiVersion}",
		"minecraft": "${minecraftDependency}",
		"java": ">=25",
		"pandorical": "*"
	},
	"suggests": {
		"village-builder": "*",
		"village-quests-justfatlard": "*",
		"block-tip": "*"
	}
}
