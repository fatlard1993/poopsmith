{
	"schemaVersion": 1,
	"id": "poopsmith",
	"version": "${version}",
	"name": "Poopsmith",
	"description": "Animals and players poop, and it all composts down into fertile ground",
	"authors": [
		"justfatlard"
	],
	"contact": {
		"sources": "https://github.com/fatlard1993/poopsmith"
	},
	"license": "MIT",
	"icon": "assets/poopsmith/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"justfatlard.poopsmith.Main"
		]
	},
	"mixins": [
		"poopsmith.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loaderVersion}",
		"fabric-api": "${fabricApiVersion}",
		"minecraft": "${minecraftDependency}",
		"java": ">=25",
		"pandorical": ">=15.0.0"
	},
	"suggests": {
		"village-builder": "*",
		"village-quests-justfatlard": "*",
		"block-tip": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.donate": "https://github.com/sponsors/fatlard1993"
			}
		}
	}
}
